# =====================================================================
# STEPS 3 - 6: Cleaning Pipeline
# =====================================================================

def standardize_unit_ids(df):
    """Step 3: Standardize varying machine identifier strings into integers."""
    df = df.copy()
    if 'unit_id' in df.columns:
        numeric_ids = df['unit_id'].astype(str).str.extract(r'(\d+\.?\d*)')[0]
        df['unit_id'] = numeric_ids.astype(float).astype(int)
    return df

def handle_missing_values(df, sensor_cols, max_gap_to_interpolate=5):
    """Step 4: Interpolate small sampling gaps and forward/backward fill edges."""
    df = df.copy()
    def interpolate_unit(group):
        group = group.sort_values('cycle')
        group[sensor_cols] = group[sensor_cols].interpolate(
            method='linear', limit=max_gap_to_interpolate, limit_direction='both'
        )
        group[sensor_cols] = group[sensor_cols].bfill().ffill()
        return group
    df = df.groupby('unit_id', group_keys=False).apply(interpolate_unit)
    return df

def clean_cycle_data(df):
    """Step 5: Verify sequence and remove duplicate time-cycles by averaging."""
    df = df.copy()
    numeric_cols = df.select_dtypes(include=[np.number]).columns.tolist()
    value_cols = [c for c in numeric_cols if c not in ['unit_id', 'cycle']]
    
    df_dedup = df.groupby(['unit_id', 'cycle'])[value_cols].mean().reset_index()
    return df_dedup.sort_values(['unit_id', 'cycle']).reset_index(drop=True)

def detect_and_treat_outliers(df, sensor_cols, iqr_multiplier=3.0):
    """Step 6: Detect impossible spikes and cap outliers to IQR bounds per unit."""
    df = df.copy()
    for col in sensor_cols:
        def treat_unit_outliers(group):
            q1, q3 = group[col].quantile(0.25), group[col].quantile(0.75)
            iqr = q3 - q1
            if iqr == 0:
                return group
            lower_bound = q1 - iqr_multiplier * iqr
            upper_bound = q3 + iqr_multiplier * iqr
            group[col] = group[col].clip(lower_bound, upper_bound)
            return group
        df = df.groupby('unit_id', group_keys=False).apply(treat_unit_outliers)
    return df

def run_cleaning_pipeline(df, sensor_cols):
    """Executes cleaning operations sequentially (Steps 3-6)."""
    print("\n--- Running Cleaning Pipeline (Steps 3-6) ---")
    df = standardize_unit_ids(df)
    print(f"  Step 3: Standardized machine identifiers. Shape: {df.shape}")
    
    df = clean_cycle_data(df)
    print(f"  Step 5: Cleaned cycle sequences (deduplicated). Shape: {df.shape}")
    
    df = handle_missing_values(df, sensor_cols)
    print(f"  Step 4: Interpolated missing values. Missing counts remaining: {df[sensor_cols].isnull().sum().sum()}")
    
    df = detect_and_treat_outliers(df, sensor_cols)
    print(f"  Step 6: Handled outlier spikes (IQR capped). Shape: {df.shape}")
    return df

# =====================================================================
# STEPS 7 - 9: Feature Engineering Pipeline
# =====================================================================

def resample_and_align(df, sensor_cols):
    """Step 7: Reindex to contiguous cycles range per unit to align sampling rates."""
    df = df.copy()
    aligned_dfs = []
    for unit, group in df.groupby('unit_id'):
        group = group.sort_values('cycle')
        min_cycle, max_cycle = int(group['cycle'].min()), int(group['cycle'].max())
        full_cycles = pd.DataFrame({'cycle': range(min_cycle, max_cycle + 1)})
        aligned_group = pd.merge(full_cycles, group, on='cycle', how='left')
        aligned_group['unit_id'] = unit
        
        all_cols = ['op_setting_1', 'op_setting_2', 'op_setting_3'] + sensor_cols
        aligned_group[all_cols] = aligned_group[all_cols].interpolate(method='linear', limit_direction='both')
        aligned_dfs.append(aligned_group)
    return pd.concat(aligned_dfs, ignore_index=True)

def normalize_sensors_native(df, sensor_cols):
    """Step 8: Scale sensor columns to [0, 1] range using native pandas calculations."""
    df = df.copy()
    variance = df[sensor_cols].var()
    non_constant = [col for col in sensor_cols if variance[col] > 1e-8]
    constant = [col for col in sensor_cols if variance[col] <= 1e-8]
    
    if non_constant:
        min_vals = df[non_constant].min()
        max_vals = df[non_constant].max()
        range_vals = max_vals - min_vals
        range_vals = range_vals.replace(0, 1.0) # avoid division by zero
        df[non_constant] = (df[non_constant] - min_vals) / range_vals
        
    for col in constant:
        df[col] = 0.0
        
    print(f"  Step 8: Normalized sensor values. (Non-constant: {len(non_constant)}, Constant: {len(constant)})")
    return df

def generate_rolling_features(df, sensor_cols, windows=[5, 10]):
    """Step 9: Compute rolling averages, mins, maxs, and stds for each sensor."""
    df = df.copy()
    new_features = {}
    for w in windows:
        grouped = df.groupby('unit_id')
        for col in sensor_cols:
            rolling_obj = grouped[col].rolling(window=w, min_periods=1)
            new_features[f"{col}_roll_mean_{w}"] = rolling_obj.mean().reset_index(level=0, drop=True)
            new_features[f"{col}_roll_std_{w}"] = rolling_obj.std().fillna(0.0).reset_index(level=0, drop=True)
            new_features[f"{col}_roll_min_{w}"] = rolling_obj.min().reset_index(level=0, drop=True)
            new_features[f"{col}_roll_max_{w}"] = rolling_obj.max().reset_index(level=0, drop=True)
            
    new_features_df = pd.DataFrame(new_features)
    return pd.concat([df, new_features_df], axis=1)

def run_feature_engineering_pipeline(df, sensor_cols, windows=[5, 10]):
    """Executes time alignment, sensor scaling, and feature generation (Steps 7-9)."""
    print("\n--- Running Feature Engineering Pipeline (Steps 7-9) ---")
    df = resample_and_align(df, sensor_cols)
    print(f"  Step 7: Resampled and aligned time cycle sequences. Shape: {df.shape}")
    
    df = normalize_sensors_native(df, sensor_cols)
    
    df = generate_rolling_features(df, sensor_cols, windows=windows)
    print(f"  Step 9: Generated rolling features (windows: {windows}). Shape: {df.shape}")
    return df

# =====================================================================
# STEP 10: Integrate Maintenance Indicators
# =====================================================================

def calculate_train_rul(df):
    """Calculates Remaining Useful Life (RUL) for training engine units."""
    df = df.copy()
    max_cycles = df.groupby('unit_id')['cycle'].max().reset_index().rename(columns={'cycle': 'max_cycle'})
    df = pd.merge(df, max_cycles, on='unit_id', how='left')
    df['RUL'] = df['max_cycle'] - df['cycle']
    df.drop(columns=['max_cycle'], inplace=True)
    return df

def calculate_test_rul(df, rul_file_path):
    """Calculates RUL for testing units using ground truth final test RUL files."""
    df = df.copy()
    if not os.path.exists(rul_file_path):
        print(f"  Warning: Ground truth RUL file not found at {rul_file_path}. Using fallback train method.")
        return calculate_train_rul(df)
        
    with open(rul_file_path, 'r') as f:
        rul_ground_truth = [float(line.strip()) for line in f.readlines() if line.strip()]
        
    unique_units = sorted(df['unit_id'].unique())
    if len(unique_units) != len(rul_ground_truth):
        print("  Warning: Unit count does not match RUL entries. Using fallback train method.")
        return calculate_train_rul(df)
        
    rul_map = dict(zip(unique_units, rul_ground_truth))
    last_cycles = df.groupby('unit_id')['cycle'].max().reset_index().rename(columns={'cycle': 'last_cycle'})
    df = pd.merge(df, last_cycles, on='unit_id', how='left')
    df['gt_final_rul'] = df['unit_id'].map(rul_map)
    df['RUL'] = df['gt_final_rul'] + df['last_cycle'] - df['cycle']
    df.drop(columns=['last_cycle', 'gt_final_rul'], inplace=True)
    return df

def run_maintenance_integration(df, is_train=True, rul_file_path=None, critical_threshold=30, warning_threshold=60):
    """Step 10: Integrate remaining useful life (RUL) and set alerts (critical = 2, warning = 1, normal = 0)."""
    print("\n--- Running Maintenance Indicators Integration (Step 10) ---")
    if is_train:
        df = calculate_train_rul(df)
    else:
        df = calculate_test_rul(df, rul_file_path)
        
    df['maintenance_alert'] = (df['RUL'] <= critical_threshold).astype(int)
    df['alert_level'] = 0
    df.loc[(df['RUL'] <= warning_threshold) & (df['RUL'] > critical_threshold), 'alert_level'] = 1
    df.loc[df['RUL'] <= critical_threshold, 'alert_level'] = 2
    
    print(f"  Step 10: Computed RUL & labels. Critical warning percentage: {df['maintenance_alert'].mean() * 100:.2f}%")
    return df

