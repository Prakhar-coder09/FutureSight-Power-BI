def main():
    print("=======================================================================")
    print("      Executing Autonomous Maintenance Assistant Pipeline (12 Steps)   ")
    print("=======================================================================")
    
    # Path configuration
    data_dir = "data"
    raw_dir = load_or_download_dataset(data_dir)
    processed_dir = os.path.join(data_dir, "processed")
    
    train_file = os.path.join(raw_dir, "train_FD001.txt")
    test_file = os.path.join(raw_dir, "test_FD001.txt")
    rul_file = os.path.join(raw_dir, "RUL_FD001.txt")
    
    # Step 1: Load raw space-separated text datasets
    print("  Loading raw dataset files...")
    train_raw = pd.read_csv(train_file, sep=r'\s+', names=COL_NAMES, header=None)
    test_raw = pd.read_csv(test_file, sep=r'\s+', names=COL_NAMES, header=None)
    
    # Save copy of raw for reporting
    train_raw_copy = train_raw.copy()
    
    # Step 2: Inspect raw data characteristics
    inspect_raw_data(train_raw, "Raw C-MAPSS Train Set")
    
    # Steps 3-6: Clean data
    train_clean = run_cleaning_pipeline(train_raw, SENSOR_COLS)
    
    # Steps 7-9: Feature engineering
    train_features = run_feature_engineering_pipeline(train_clean, SENSOR_COLS, windows=[5, 10])
    
    # Step 10: Integrate Remaining Useful Life (RUL) & alerts
    train_final = run_maintenance_integration(train_features, is_train=True)
    
    # Process test data using same steps
    print("\n--- Processing Test Set ---")
    test_clean = run_cleaning_pipeline(test_raw, SENSOR_COLS)
    test_features = run_feature_engineering_pipeline(test_clean, SENSOR_COLS, windows=[5, 10])
    test_final = run_maintenance_integration(test_features, is_train=False, rul_file_path=rul_file)
    
