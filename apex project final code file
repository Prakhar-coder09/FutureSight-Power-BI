def generate_quality_report(df_raw, df_clean, sensor_cols, output_path):
    """Step 11: Compares raw and processed datasets and exports a Markdown report."""
    print("\n--- Step 11: Generating Data Quality Comparison Report ---")
    report_lines = [
        "# Data Quality Comparison Report",
        "\nThis report summarizes data metrics before and after the preprocessing pipeline.",
        "\n## 1. Dataset Dimensions",
        f"- **Raw Dataset**: {df_raw.shape[0]} rows, {df_raw.shape[1]} columns",
        f"- **Processed Dataset**: {df_clean.shape[0]} rows, {df_clean.shape[1]} columns",
        "\n## 2. Missing Values Summary"
    ]
    
    raw_missing = df_raw[sensor_cols].isnull().sum()
    clean_missing = df_clean[sensor_cols].isnull().sum() if all(c in df_clean.columns for c in sensor_cols) else pd.Series(0, index=sensor_cols)
    
    report_lines.append("\n| Sensor | Raw Missing Count | Raw Missing % | Clean Missing Count | Clean Missing % |")
    report_lines.append("|---|---|---|---|---|")
    for s in sensor_cols:
        raw_c, raw_p = raw_missing[s], (raw_missing[s] / len(df_raw)) * 100
        clean_c, clean_p = clean_missing[s], (clean_missing[s] / len(df_clean)) * 100
        report_lines.append(f"| {s} | {raw_c:.0f} | {raw_p:.2f}% | {clean_c:.0f} | {clean_p:.2f}% |")
        
    report_lines.append("\n## 3. Outlier Statistics (values > 1.5 IQR from quartiles)")
    report_lines.append("\n| Sensor | Raw Outliers Count | Raw Outliers % | Clean Outliers Count | Clean Outliers % |")
    report_lines.append("|---|---|---|---|---|")
    
    for col in sensor_cols:
        # Raw outlier check
        q1_r, q3_r = df_raw[col].quantile(0.25), df_raw[col].quantile(0.75)
        iqr_r = q3_r - q1_r
        raw_out = ((df_raw[col] < (q1_r - 1.5 * iqr_r)) | (df_raw[col] > (q3_r + 1.5 * iqr_r))).sum() if iqr_r > 0 else 0
        raw_out_pct = (raw_out / len(df_raw)) * 100
        
        # Clean outlier check
        q1_c, q3_c = df_clean[col].quantile(0.25), df_clean[col].quantile(0.75)
        iqr_c = q3_c - q1_c
        clean_out = ((df_clean[col] < (q1_c - 1.5 * iqr_c)) | (df_clean[col] > (q3_c + 1.5 * iqr_c))).sum() if iqr_c > 0 else 0
        clean_out_pct = (clean_out / len(df_clean)) * 100
        
        report_lines.append(f"| {col} | {raw_out:.0f} | {raw_out_pct:.2f}% | {clean_out:.0f} | {clean_out_pct:.2f}% |")
        
    with open(output_path, 'w') as f:
        f.write('\n'.join(report_lines))
    print(f"  Step 11: Data quality report saved to {output_path}")

