def download_file(url, dest_path):
    """Downloads a file from a URL to a destination path."""
    try:
        print(f"  Attempting to download from {url}...")
        urllib.request.urlretrieve(url, dest_path)
        print(f"  Successfully downloaded to {dest_path}")
        return True
    except Exception as e:
        print(f"  Failed to download: {e}")
        return False

def generate_synthetic_data(data_dir):
    """Generates realistic synthetic CMAPSS-like raw dataset with intentional flaws."""
    print("  Generating synthetic CMAPSS-like raw data with intentional flaws for pipeline testing...")
    np.random.seed(42)
    n_units = 15
    train_records = []
    test_records = []
    test_rul = []
    
    # Baselines and trends mimicking actual CMAPSS sensors
    sensor_baselines = {
        's_1': 518.67, 's_2': 642.5, 's_3': 1589.0, 's_4': 1400.0, 's_5': 14.62,
        's_6': 21.61, 's_7': 553.0, 's_8': 2388.0, 's_9': 9046.0, 's_10': 1.3,
        's_11': 47.0, 's_12': 521.0, 's_13': 2388.0, 's_14': 8138.0, 's_15': 8.4,
        's_16': 0.03, 's_17': 392.0, 's_18': 2388.0, 's_19': 100.0, 's_20': 39.0,
        's_21': 23.3
    }
    sensor_trends = {
        's_2': (1, 0.05), 's_3': (1, 0.15), 's_4': (1, 0.2), 's_7': (-1, 0.08),
        's_8': (1, 0.01), 's_11': (1, 0.02), 's_12': (-1, 0.08), 's_13': (1, 0.01),
        's_15': (1, 0.002), 's_17': (1, 0.04), 's_20': (-1, 0.03), 's_21': (-1, 0.03)
    }

    # Generate Train Dataset
    for i in range(1, n_units + 1):
        # Format the unit identifiers inconsistently to test step 3
        if i % 3 == 0:
            unit_id_str = f"Unit_{i}"
        elif i % 3 == 1:
            unit_id_str = f"{i}.0"
        else:
            unit_id_str = str(i)
            
        max_lifetime = np.random.randint(120, 240)
        
        for cycle in range(1, max_lifetime + 1):
            # Simulate timestamp gaps/uneven sampling (skip ~2% of cycles randomly)
            if np.random.rand() < 0.02 and 1 < cycle < max_lifetime:
                continue
                
            row = {
                "unit_id": unit_id_str,
                "cycle": cycle,
                "op_setting_1": np.random.normal(0.002, 0.001),
                "op_setting_2": np.random.normal(0.0002, 0.0001),
                "op_setting_3": 100.0
            }
            
            deg_frac = (cycle / max_lifetime) ** 2
            
            for s in SENSOR_COLS:
                base = sensor_baselines[s]
                val = base
                if s in sensor_trends:
                    direction, rate = sensor_trends[s]
                    val += direction * rate * deg_frac * base * 0.05
                    
                val += np.random.normal(0, base * 0.003)
                
                # Introduce missing values (Step 4 testing)
                if np.random.rand() < 0.015:
                    val = np.nan
                    
                # Introduce outliers / spikes (Step 6 testing)
                if np.random.rand() < 0.005:
                    val = val * (10 if np.random.rand() > 0.5 else 0.1)
                
                row[s] = val
                
            train_records.append(row)
            
            # Introduce duplicated cycles (Step 5 testing)
            if np.random.rand() < 0.008 and cycle > 1:
                dup_row = row.copy()
                dup_row["op_setting_1"] += 0.0005
                train_records.append(dup_row)

    # Generate Test Dataset & RUL list
    for i in range(1, n_units + 1):
        unit_id_str = f"Unit_{i}" if i % 3 == 0 else (f"{i}.0" if i % 3 == 1 else str(i))
        full_lifetime = np.random.randint(120, 240)
        truncated_lifetime = np.random.randint(40, full_lifetime - 20)
        test_rul.append(full_lifetime - truncated_lifetime)
        
        for cycle in range(1, truncated_lifetime + 1):
            row = {
                "unit_id": unit_id_str,
                "cycle": cycle,
                "op_setting_1": np.random.normal(0.002, 0.001),
                "op_setting_2": np.random.normal(0.0002, 0.0001),
                "op_setting_3": 100.0
            }
            
            deg_frac = (cycle / full_lifetime) ** 2
            for s in SENSOR_COLS:
                base = sensor_baselines[s]
                val = base
                if s in sensor_trends:
                    direction, rate = sensor_trends[s]
                    val += direction * rate * deg_frac * base * 0.05
                    
                val += np.random.normal(0, base * 0.003)
                
                if np.random.rand() < 0.015:
                    val = np.nan
                if np.random.rand() < 0.005:
                    val = val * (10 if np.random.rand() > 0.5 else 0.1)
                
                row[s] = val
            test_records.append(row)

    train_df = pd.DataFrame(train_records)
    test_df = pd.DataFrame(test_records)
    
    # Save files to disk
    train_df.to_csv(os.path.join(data_dir, "train_FD001.txt"), sep=" ", header=False, index=False)
    test_df.to_csv(os.path.join(data_dir, "test_FD001.txt"), sep=" ", header=False, index=False)
    with open(os.path.join(data_dir, "RUL_FD001.txt"), "w") as f:
        for val in test_rul:
            f.write(f"{val}\n")
            
    print(f"  Generated training dataset ({len(train_df)} rows)")
    print(f"  Generated test dataset ({len(test_df)} rows)")

def load_or_download_dataset(data_dir="data"):
    """Prepares the dataset directory and files (by download or fallback simulation)."""
    print("\n--- Step 1: Loading / Ingesting Dataset ---")
    raw_dir = os.path.join(data_dir, "raw")
    processed_dir = os.path.join(data_dir, "processed")
    os.makedirs(raw_dir, exist_ok=True)
    os.makedirs(processed_dir, exist_ok=True)
    
    base_url = "https://raw.githubusercontent.com/alr-packages/CMAPSS/master/CMAPSS/"
    files = ["train_FD001.txt", "test_FD001.txt", "RUL_FD001.txt"]
    
    download_success = True
    for f in files:
        dest = os.path.join(raw_dir, f)
        url = base_url + f
        if not download_file(url, dest):
            download_success = False
            break
            
    if not download_success:
        print("  Internet connection issue or mirror offline. Initiating synthetic fallback generator...")
        generate_synthetic_data(raw_dir)
    else:
        print("  Successfully downloaded C-MAPSS dataset files from mirror.")
        
    return raw_dir

